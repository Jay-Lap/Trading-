# ===== 실행 모드 =====
# paper   : 실제 시세로 내 컴퓨터 안에서만 가상 매매 (키 필요 없음)  ← 처음엔 이것
# testnet : 바이낸스 모의(데모) 선물 계좌에 실제 API 주문 (데모 키 필요)
# live    : 진짜 돈. 아래 LIVE_CONFIRM 문구까지 정확히 적어야만 켜집니다.
MODE=paper
LIVE_CONFIRM=

# ===== API 키 (testnet/live 에서만) =====
# 바이낸스에서 키 만들 때: "Enable Futures" 만 켜고, 출금(Withdrawals)은 절대 켜지 마세요.
# IP 제한(Restrict access to trusted IPs)도 꼭 거세요.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 주소를 바꿀 일은 거의 없습니다.
LIVE_BASE_URL=https://fapi.binance.com
TESTNET_BASE_URL=https://demo-fapi.binance.com

# ===== 종목 / 전략 =====
SYMBOLS=BTCUSDT,ETHUSDT
# 15m 은 거래가 너무 잦아 수수료로 손해 (1년 백테스트 기준). 1h 또는 4h 권장.
INTERVAL=1h
EMA_FAST=20
EMA_SLOW=50
ATR_PERIOD=14
STOP_ATR_MULT=2
TAKE_PROFIT_ATR_MULT=3
# 추세 필터: 장기 EMA 방향과 같을 때만 진입 (0 = 끔)
TREND_EMA=200
# 추세 강도 필터: ADX 가 이 값 이상일 때만 진입 (0 = 끔)
ADX_MIN=25
ADX_PERIOD=14
POLL_SECONDS=20

# ===== 리스크 한도 (가장 중요) =====
# 한 번 거래에서 잃어도 되는 돈 = 계좌의 몇 % (손절 시 손실)
RISK_PER_TRADE_PCT=1
# 레버리지 (코드에서 10배 초과는 무조건 거부)
LEVERAGE=3
# 한 포지션 최대 규모 (USDT, 레버리지 포함 명목금액)
MAX_NOTIONAL_USDT=200
# 하루 손실이 계좌의 몇 %를 넘으면 그날(UTC) 신규 진입 중단
DAILY_MAX_LOSS_PCT=3
# 재시작 후 손절주문 없는 포지션을 발견하면 진입가 대비 몇 %에 비상 손절
EMERGENCY_STOP_PCT=2

# paper 모드 시작 자금
PAPER_START_USDT=1000
