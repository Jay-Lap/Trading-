# ===== 실행 모드 =====
# paper   : 실제 시세로 내 컴퓨터 안에서만 가상 매매 (키 필요 없음)  ← 처음엔 이것
# testnet : 바이낸스 모의(데모) 선물 계좌에 실제 API 주문 (데모 키 필요)
# live    : 진짜 돈. 아래 LIVE_CONFIRM 문구까지 정확히 적어야만 켜집니다.
MODE=paper
LIVE_CONFIRM=

# ===== API 키 (testnet/live 에서만) =====
# 바이낸스에서 키 만들 때: "Enable Futures" 만 켜고, 출금(Withdrawals)은 절대 켜지 마세요.
# IP 제한(Restrict access to trusted IPs)도 꼭 거세요.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 주소를 바꿀 일은 거의 없습니다.
LIVE_BASE_URL=https://fapi.binance.com
TESTNET_BASE_URL=https://demo-fapi.binance.com

# ===== 종목 / 전략 =====
# committee : AI 헤지펀드식 위원회. 애널리스트 4명(추세·돌파·모멘텀·장기국면)이 투표 → 확신이 강할 때만 진입 (권장)
# ema       : EMA 20/50 교차 단일 전략 (아래 TREND_EMA, ADX_MIN 필터 적용)
STRATEGY=committee
# 위원회 확신(-1~+1)이 이 값 이상일 때만 진입, 절반 이상 반대로 돌면 청산
COMMITTEE_THRESHOLD=0.5
COMMITTEE_ADX_MIN=20
# 2년 백테스트(4h 위원회)에서 3종 + 아래 포지션 한도가 수익 대비 낙폭이 가장 좋았음.
# 대형 9종: BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,LTCUSDT (낙폭이 커져 MAX_OPEN_POSITIONS=5, MAX_SAME_DIRECTION=3 권장)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# 15m 은 거래가 너무 잦아 수수료로 손해 (1년 백테스트 기준). committee 는 4h 에서 가장 좋았음.
INTERVAL=4h
EMA_FAST=20
EMA_SLOW=50
ATR_PERIOD=14
STOP_ATR_MULT=2
# 0 = 고정 익절 없음: 추세를 끝까지 타고, 위원회가 반대로 돌아서거나 손절될 때만 청산 (기본, 3년 백테스트 최고)
# 3 = 손절폭의 1.5배에서 익절 (승률↑, 수익↓)
TAKE_PROFIT_ATR_MULT=0
# 상위 타임프레임 위원회 확인 (예: 1d). 백테스트에서 수익을 줄여서 기본은 끔
HTF_INTERVAL=
# 추세 필터: 장기 EMA 방향과 같을 때만 진입 (0 = 끔)
TREND_EMA=200
# 추세 강도 필터: ADX 가 이 값 이상일 때만 진입 (0 = 끔)
ADX_MIN=25
ADX_PERIOD=14
POLL_SECONDS=20

# ===== 리스크 한도 (가장 중요) =====
# 한 번 거래에서 잃어도 되는 돈 = 계좌의 몇 % (손절 시 손실)
RISK_PER_TRADE_PCT=1
# 레버리지 (코드에서 10배 초과는 무조건 거부)
LEVERAGE=3
# 한 포지션 최대 규모 (USDT, 레버리지 포함 명목금액)
MAX_NOTIONAL_USDT=200
# 하루 손실이 계좌의 몇 %를 넘으면 그날(UTC) 신규 진입 중단
DAILY_MAX_LOSS_PCT=3
# 동시에 들고 있을 수 있는 포지션 수 / 같은 방향(롱 또는 숏) 최대 수
# 코인끼리 같이 움직이므로 같은 방향 여러 개 = 사실상 한 베팅을 키운 것. 신호가 겹치면 확신이 큰 순서로 채움.
MAX_OPEN_POSITIONS=3
MAX_SAME_DIRECTION=2
# 변동성 필터: 손절폭(ATR×2)이 진입가의 이 % 를 넘으면 너무 요동치는 장이라 쉼 (0 = 끔)
# 레버리지 10배가 좋아 보였던 이유가 바로 이 효과(10배 = 5% 필터와 결과 동일). 레버리지는 3배로 두고 필터만 사용.
MAX_STOP_PCT=6
# 재시작 후 손절주문 없는 포지션을 발견하면 진입가 대비 몇 %에 비상 손절
EMERGENCY_STOP_PCT=2

# paper 모드 시작 자금
PAPER_START_USDT=1000
